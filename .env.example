# ============================================================================
# toıdym — Environment Variables & API Keys Guide (.env.example)
# NEVER commit real `.env` secrets to Git!
# ============================================================================

# ----------------------------------------------------------------------------
# 1. FLUTTER CLIENT KEYS (Safe to bundle in app via --dart-define or AppConfig)
# Found in: Supabase / Lovable Cloud -> Project Settings -> API
# ----------------------------------------------------------------------------
SUPABASE_PROJECT_ID=kpmknrlltuzmilvtlshg
SUPABASE_URL=https://c--7afbd424-5b38-450a-aab4-ba0d1eca81f2-prod.lovable.cloud
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_ANON_KEY=
USE_BACKEND=true
TOIDYM_ADMINS=+77000000001,+77012345678

# Optional: Custom reverse-proxy / backend base URL (defaults to SUPABASE_URL)
API_BASE_URL=

# ----------------------------------------------------------------------------
# 2. SERVER-ONLY / EDGE FUNCTION SECRETS (NEVER put in Flutter client!)
# Upload to Supabase via: `supabase secrets set --env-file supabase/.env`
# Or Dashboard -> Edge Functions -> Manage Secrets
# ----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY
CRON_SECRET=YOUR_RANDOM_32_CHAR_CRON_SECRET

# Direct Postgres Connection URI (CLI / migrations only):
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ----------------------------------------------------------------------------
# 3. OPTIONAL: FIREBASE CLOUD MESSAGING (FCM) PUSH NOTIFICATIONS
# Found in: Firebase Console -> Project Settings -> Cloud Messaging / Service Accounts
# Needed ONLY if you want real mobile/web push notifications when Resale CRON gives a Strike
# ----------------------------------------------------------------------------
FCM_LEGACY_SERVER_KEY=
# Or FCM HTTP v1 endpoint + OAuth access token / Google Service Account JSON
FCM_PROJECT_ID=
